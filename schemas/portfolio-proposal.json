{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortfolioProposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "portfolio-proposal-v1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "policy_bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "security_id": {"type": "string", "minLength": 1},
          "weight": {"type": "string", "pattern": "^(?:0\\.\\d{6}|1\\.000000)$"}
        },
        "required": ["security_id", "weight"]
      }
    },
    "horizon_sessions": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "constraints": {"type": "object"},
    "construction": {"type": "object"}
  },
  "required": ["schema_version", "proposal_id", "policy_bundle_id", "snapshot_hash", "account_hash", "targets", "horizon_sessions", "expires_at", "evidence_ids", "rationale", "constraints", "construction"]
}
