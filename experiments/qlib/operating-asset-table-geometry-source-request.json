  "geometry_python": "import hashlib,json,sys,subprocess\nfrom pathlib import Path\nimport pdfplumber\nroot=Path.cwd();base=Path(sys.argv[1]).resolve();request_file=Path(sys.argv[2]).resolve();expected_sha=sys.argv[3]\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nread=lambda p:json.loads(Path(p).read_text())\ndef need(ok,message):\n    if not ok:raise ValueError(message)\ndef write(p,value):\n    with p.open('x') as f:json.dump(value,f,ensure_ascii=False,indent=2,allow_nan=False);f.write('\\n')\nneed(sha(request_file)==expected_sha,'frozen geometry-source request');req=read(request_file)\nneed(req['status']=='FROZEN_ORIGINAL_ASSET_TABLE_GEOMETRY_SOURCE_ONLY' and len(req['documents'])==4\n     and sum(len(d['geometry_physical_pages']) for d in req['documents'])==12 and req['rendered_asset_total_pages']==4,'exact four-PDF twelve-page source scope')\nneed(pdfplumber.__version__==req['pdfplumber_version'] and sys.version.split()[0]==req['python_version']\n     and sha(req['render_binary'])==req['render_binary_sha256'],'bound geometry source tools')\npaths={}\nfor key in req['input_sha256']:\n    prefix,relative=key.split('/',1);anchor={'repo':root,'source':base}[prefix].resolve();path=(anchor/relative).resolve();need(path.is_relative_to(anchor),'safe frozen namespace');paths[key]=path\npaths['frozen_request']=request_file;expected={**req['input_sha256'],'frozen_request':expected_sha}\nneed({k:sha(p) for k,p in paths.items()}==expected,'geometry inputs before')\nout=base/req['output_subdir'];out.mkdir(exist_ok=False);write(out/'input-before.json',expected);complete=[];original=None\ntry:\n    for doc in req['documents']:\n        need(doc['day']<='2025-06-30' and 2022<=doc['effective_fiscal_year']<=2024,'fixed historical source scope')\n        pdf=base/doc['source_path'];need(sha(pdf)==doc['source_sha256'],'original source PDF');folder=out/doc['capture_key'];folder.mkdir();records=[]\n        with pdfplumber.open(pdf) as document:\n            for number in doc['geometry_physical_pages']:\n                page=document.pages[number-1];tables=page.find_tables(table_settings=req['table_settings'])\n                data={'physical_page':number,'width':page.width,'height':page.height,'tables':[\n                    {'bbox':list(t.bbox),'cells':[list(c) for c in t.cells],'rows':t.extract()} for t in tables],\n                    'words':page.extract_words(x_tolerance=3,y_tolerance=3,keep_blank_chars=False),\n                    'source_sha256':doc['source_sha256'],'geometry_is_pdfminer_derived_not_a_third_independent_decoder':True}\n                target=folder/f'geometry-page-{number}.json';write(target,data);records.append({'page':number,'tables':len(tables),'sha256':sha(target)})\n        number=doc['asset_total_row_physical_page']\n        subprocess.run([req['render_binary'],'-f',str(number),'-l',str(number),'-r','110','-singlefile','-png',str(pdf),str(folder/f'asset-total-page-{number}')],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE)\n        complete.append({'capture_key':doc['capture_key'],'geometry_pages':records,'asset_total_row_rendered_page':number})\n    write(out/'inspection.json',{'status':'ORIGINAL_TABLE_GEOMETRY_NOT_PARSED_FACTOR','documents':complete,'numeric_factor_or_return_computed':False,'denominator_admitted':False})\nexcept BaseException as exc:original=exc\nfinally:\n    mismatches=[]\n    for key,path in paths.items():\n        try:\n            if sha(path)!=expected[key]:mismatches.append(key)\n        except BaseException:mismatches.append(key)\n    if sha(req['render_binary'])!=req['render_binary_sha256']:mismatches.append('render_binary')\n    write(out/'terminal.json',{'completed':original is None and not mismatches and len(complete)==4,'documents':complete,\n        'all_input_sha256':expected,'all_inputs_unchanged':not mismatches,'mismatches':mismatches,\n        'original_error':None if original is None else {'type':type(original).__name__,'message':str(original)},\n        'output_sha256':{str(p.relative_to(out)):sha(p) for p in sorted(out.rglob('*')) if p.is_file()},'denominator_admitted':False,'investment_factor_admitted':False})\nif original is not None:raise original\nneed(not mismatches,'geometry source inputs unchanged');print('original asset geometry complete:4PDFs/12pages/4asset-row renders; no factor/return')\n",
